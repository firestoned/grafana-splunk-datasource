{
  "name": "firestoned-splunk-datasource",
  "version": "0.1.1",
  "description": "Grafana data source plugin for Splunk",
  "scripts": {
    "build": "TS_NODE_PROJECT=./.config/tsconfig.json webpack -c ./.config/webpack/webpack.config.ts --env production",
    "postbuild": "node -e \"const f='dist/plugin.json',j=require('./'+f);delete j.generated;require('fs').writeFileSync(f,JSON.stringify(j,null,4))\"",
    "dev": "TS_NODE_PROJECT=./.config/tsconfig.json webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "package": "rm -rf .pkg && mkdir -p .pkg/firestoned-splunk-datasource && cp -R dist/. .pkg/firestoned-splunk-datasource/ && (cd .pkg && zip -rq ../firestoned-splunk-datasource-$npm_package_version.zip firestoned-splunk-datasource) && rm -rf .pkg && echo \"wrote firestoned-splunk-datasource-$npm_package_version.zip\""
  },
  "author": "firestoned",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@grafana/eslint-config": "^7.0.0",
    "@grafana/tsconfig": "^1.3.0-rc1",
    "@grafana/create-plugin": "^4.10.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.194",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/react-router-dom": "^5.2.0",
    "@types/testing-library__jest-dom": "5.14.8",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "eslint": "^8.57.0",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-webpack-plugin": "^4.0.1",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.2.7",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-virtual-modules": "^0.6.2",
    "@grafana/plugin-meta-extractor": "^0.0.12"
  },
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@grafana/data": "^11.0.0",
    "@grafana/runtime": "^11.0.0",
    "@grafana/schema": "^11.0.0",
    "@grafana/ui": "^11.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tslib": "^2.6.2"
  },
  "overrides": {
    "form-data": "^4.0.4",
    "dompurify": "^3.4.0",
    "serialize-javascript": "^7.0.5",
    "minimatch": "^9.0.7",
    "lodash": "^4.17.21",
    "js-yaml": "^4.1.1",
    "nanoid": "^3.3.8",
    "qs": "^6.14.2",
    "@tootallnate/once": "^3.0.1",
    "immutable": "^5.1.5",
    "tough-cookie": "^4.1.3",
    "uuid": "^14.0.0",
    "underscore": "^1.13.7"
  },
  "engines": {
    "node": ">=20"
  }
}
